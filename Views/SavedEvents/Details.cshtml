@using System.Globalization
@model SavedEvent
@{
    ViewData["Title"] = "Saved Event";
    var inv = CultureInfo.InvariantCulture;
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0">Saved event</h4>
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← Back to my saved events</a>
</div>

<div class="card">
    <div class="card-body">
        <table class="table table-borderless">
            <tbody>
                <tr><th scope="row" style="width: 30%;">Magnitude</th><td>@(Model.Magnitude.HasValue ? Model.Magnitude.Value.ToString("0.0", inv) : "N/A")</td></tr>
                <tr><th scope="row">Location</th><td>@Model.Place</td></tr>
                <tr><th scope="row">Time (UTC)</th><td>@Model.EventTime.ToString("yyyy-MM-dd HH:mm")</td></tr>
                <tr><th scope="row">Depth</th><td>@Model.DepthKm.ToString("0.0", inv) km</td></tr>
                <tr><th scope="row">Coordinates</th><td>@Model.Latitude.ToString("0.0000", inv), @Model.Longitude.ToString("0.0000", inv)</td></tr>
                <tr><th scope="row">Priority</th><td>@Model.Priority</td></tr>
                <tr><th scope="row">Status</th><td>@Model.Status</td></tr>
                <tr><th scope="row">Your note</th><td>@(string.IsNullOrEmpty(Model.Note) ? "-" : Model.Note)</td></tr>
                <tr><th scope="row">Saved on</th><td>@Model.SavedAt.ToLocalTime().ToString("g")</td></tr>
            </tbody>
        </table>

        <div class="d-flex flex-wrap gap-2">
            @if (!string.IsNullOrEmpty(Model.SourceUrl) && Model.SourceUrl.StartsWith("https://"))
            {
                <a href="@Model.SourceUrl" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">View on USGS</a>
            }
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">Edit</a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">Remove</a>
        </div>
    </div>
</div>
