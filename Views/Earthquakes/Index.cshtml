@using System.Globalization
@model DashboardViewModel
@{
    ViewData["Title"] = "Earthquake Dashboard";
    var inv = CultureInfo.InvariantCulture;

    var strongestText = "N/A";
    if (Model.Strongest != null && Model.Strongest.Magnitude.HasValue)
    {
        strongestText = "M " + Model.Strongest.Magnitude.Value.ToString("0.0", inv) + " - " + Model.Strongest.Place;
    }
    var averageText = Model.AverageMagnitude.HasValue ? Model.AverageMagnitude.Value.ToString("0.00", inv) : "N/A";

    // Data handed to dashboard.js (map markers + chart numbers)
    var points = Model.Earthquakes.Select(e => new
    {
        id = e.Id,
        mag = e.Magnitude,
        place = e.Place,
        time = e.Time.ToString("yyyy-MM-dd HH:mm") + " UTC",
        lat = e.Latitude,
        lon = e.Longitude
    }).ToList();

    var chartData = new
    {
        points = points,
        detailsBase = Url.Action("Details", "Earthquakes"),
        magnitudeBuckets = Model.MagnitudeBuckets,
        dayLabels = Model.DayLabels,
        dayCounts = Model.DayCounts
    };
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0">Live Earthquake Dashboard</h4>
    <div>
        <small class="text-muted me-2">Page loaded @Model.LoadedAt.ToString("g")</small>
        <a class="btn btn-outline-primary btn-sm" asp-action="Refresh">🔄 Refresh Data</a>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger" role="alert">
        ⚠ Unable to load earthquake data. @Model.ErrorMessage
        <a asp-action="Refresh" class="alert-link">Try again</a>
    </div>
}

@* ---------- Watch list alert (logged-in users only) ---------- *@
@if (Model.IsLoggedIn && Model.WatchMatches.Any())
{
    <div class="alert alert-warning" role="alert">
        <strong>⚠ Watch list alert:</strong> earthquakes from the last 7 days match your watch list.
        <ul class="mb-1">
            @foreach (var match in Model.WatchMatches)
            {
                var top = match.Earthquakes.First();
                <li>
                    <strong>@match.Item.Name</strong>
                    (@match.Item.RegionKeyword, magnitude @(match.Item.MinMagnitude.ToString("0.0", inv))+):
                    @match.Earthquakes.Count matching, strongest magnitude @(top.Magnitude!.Value.ToString("0.0", inv)) - @top.Place
                    <a asp-action="Details" asp-route-id="@top.Id" class="alert-link">details</a>
                </li>
            }
        </ul>
        <small>Based on the last 7 days of USGS data and checked each time this page loads. This is not a real-time alert.</small>
    </div>
}

@* ---------- Summary cards ---------- *@
<div class="row g-3 mb-4">
    <div class="col-6 col-md-2">
        <div class="card text-center h-100 stat-card"><div class="card-body">
            <h6 class="card-title">Total Earthquakes</h6>
            <p class="fs-3 fw-bold mb-0">@Model.TotalCount</p>
        </div></div>
    </div>
    <div class="col-6 col-md-4">
        <div class="card text-center h-100 stat-card"><div class="card-body">
            <h6 class="card-title">Strongest Earthquake</h6>
            <p class="fs-6 fw-bold mb-0" title="@strongestText">@strongestText</p>
        </div></div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center h-100 stat-card"><div class="card-body">
            <h6 class="card-title">Average Magnitude</h6>
            <p class="fs-3 fw-bold mb-0">@averageText</p>
        </div></div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center h-100 stat-card"><div class="card-body">
            <h6 class="card-title">Magnitude 5+</h6>
            <p class="fs-3 fw-bold mb-0">@Model.Mag5Count</p>
        </div></div>
    </div>
    <div class="col-6 col-md-2">
        <div class="card text-center h-100 stat-card"><div class="card-body">
            <h6 class="card-title">Tsunami Flag</h6>
            <p class="fs-3 fw-bold mb-0">@Model.TsunamiCount</p>
        </div></div>
    </div>
</div>

@* ---------- Filters (form handling with GET) ---------- *@
@if (Model.FiltersRestored)
{
    <div class="alert alert-secondary py-2 small" role="alert">
        Showing the filters from your last visit (remembered in your session).
        <a asp-action="Reset" class="alert-link">Clear them</a>
    </div>
}

<form method="get" asp-controller="Earthquakes" asp-action="Index" class="card card-body mb-4">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="row g-3 align-items-end">
        <div class="col-6 col-md-2">
            <label class="form-label" for="MinMagnitude">Min magnitude</label>
            <input type="number" step="0.1" class="form-control" id="MinMagnitude" name="MinMagnitude"
                   value="@(Model.Filter.MinMagnitude?.ToString(inv))" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="MaxMagnitude">Max magnitude</label>
            <input type="number" step="0.1" class="form-control" id="MaxMagnitude" name="MaxMagnitude"
                   value="@(Model.Filter.MaxMagnitude?.ToString(inv))" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="FromDate">From (UTC date)</label>
            <input type="date" class="form-control" id="FromDate" name="FromDate"
                   value="@(Model.Filter.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label" for="ToDate">To (UTC date)</label>
            <input type="date" class="form-control" id="ToDate" name="ToDate"
                   value="@(Model.Filter.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-12 col-md-4">
            <label class="form-label" for="Location">Search location</label>
            <input type="text" class="form-control" id="Location" name="Location" maxlength="100"
                   placeholder="e.g. Alaska, Japan" value="@Model.Filter.Location" />
        </div>
        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Apply Filters</button>
            <a asp-action="Reset" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

@* ---------- Map ---------- *@
<div class="card mb-4">
    <div class="card-header">Earthquake Map</div>
    <div class="card-body">
        <div id="map" style="height: 500px;"></div>
    </div>
</div>

@* ---------- Charts ---------- *@
<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Earthquakes by Magnitude Range</div>
            <div class="card-body"><div class="chart-box"><canvas id="magnitudeRangeChart"></canvas></div></div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">Earthquakes per Day (UTC)</div>
            <div class="card-body"><div class="chart-box"><canvas id="earthquakesPerDayChart"></canvas></div></div>
        </div>
    </div>
</div>

@* ---------- Table (all matching earthquakes) ---------- *@
<div class="card mb-4">
    <div class="card-header">Recent Earthquakes (@Model.TotalCount)</div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Magnitude</th>
                        <th>Location</th>
                        <th>Time (UTC)</th>
                        <th>Depth</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Earthquakes.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted">No earthquakes match your filters</td></tr>
                    }
                    @foreach (var quake in Model.Earthquakes)
                    {
                        <tr>
                            <td>@(quake.Magnitude.HasValue ? quake.Magnitude.Value.ToString("0.0", inv) : "N/A")</td>
                            <td>@quake.Place</td>
                            <td>@quake.Time.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@quake.DepthKm.ToString("0.0", inv) km</td>
                            <td class="text-nowrap">
                                <a asp-action="Details" asp-route-id="@quake.Id" class="btn btn-sm btn-outline-primary">Details</a>
                                @if (Model.SavedIds.Contains(quake.Id))
                                {
                                    <span class="badge bg-success">Saved</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        window.dashboardData = @Json.Serialize(chartData);
    </script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
